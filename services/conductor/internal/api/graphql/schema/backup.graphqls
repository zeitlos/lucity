"""The backups of one database. Base backups are taken on a schedule and the write-ahead log is archived continuously in between, so any moment from `earliestRestorePoint` to `latestRestorePoint` can be restored."""
type DatabaseBackups {
  enabled: Boolean!
  retentionDays: Int!
  schedule: String!
  """The furthest back this database can be restored to."""
  earliestRestorePoint: Time
  latestRestorePoint: Time
  lastBackupAt: Time
  backups: [DatabaseBackup!]!
}

type DatabaseBackup {
  """The backup, as its database id followed by the backup's own name."""
  id: ID!
  status: BackupStatus!
  createdAt: Time!
  trigger: BackupTrigger!
  startedAt: Time
  finishedAt: Time
  error: String
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
}

extend type Database {
  backups: DatabaseBackups! @goField(forceResolver: true)
}

"""Restoring never touches the source database. It creates a second one holding the data as it was at `targetTime`, which keeps running alongside the original until you decide what to do with it."""
type RestoreDatabaseResult {
  database: Database!
  """
  True when the requested moment was later than anything in the archive, so the
  restore ran to the most recent state instead. Only happens while archiving is
  healthy, which means nothing was written after that point.
  """
  clampedToLatest: Boolean!
}

input RestoreDatabaseInput {
  database: DatabaseID!
  """What people read, such as `Orders restored`. Any text, and it can be changed later."""
  name: String! @constraint(constraint: "min=1,max=128")
  """The id: 2 to 16 lowercase letters, digits and hyphens, fixed once created. Derived from `name` when left out, with a counter added when that id is taken. A given id that is taken is refused."""
  id: String @constraint(constraint: "resource_name,min=2,max=16")
  """Omit to restore the most recent state in the archive."""
  targetTime: Time
}

extend type Mutation {
  """Starts a full backup of a database now. If a backup is already running, that one is returned instead."""
  createDatabaseBackup(database: DatabaseID!): DatabaseBackup! @hasRole(role: WORKSPACE_MEMBER)
  """Restores the backups of a database into a new database in the same environment, leaving the original untouched. Leave `targetTime` out to restore the latest state."""
  restoreDatabase(input: RestoreDatabaseInput!): RestoreDatabaseResult! @hasRole(role: WORKSPACE_MEMBER)
}
