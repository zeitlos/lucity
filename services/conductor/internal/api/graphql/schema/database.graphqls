type Database {
  id: DatabaseID!
  name: String!
  version: String!
  instances: Int!
  status: DatabaseStatus!
  """Why the database is in this state, when it is not healthy."""
  statusReason: String
  size: String!
  resources: Resources!
  createdAt: Time!
  public: Boolean!
  """Address ranges allowed to connect over the public hostname. While the list is empty, nobody can."""
  allowRules: [DatabaseAllowRule!]! @goField(forceResolver: true)
}

type DatabaseAllowRule {
  """An IPv4 range in CIDR notation, such as `203.0.113.7/32`. `0.0.0.0/0` allows any address."""
  range: String!
  description: String!
}

input DatabaseAllowRuleInput {
  """An IPv4 address, such as `203.0.113.7`, or a range in CIDR notation, such as `203.0.113.0/24`. `0.0.0.0/0` allows any address."""
  range: String! @constraint(constraint: "cidrv4|ipv4")
  """A note on whose address this is, such as `Office`."""
  description: String! @constraint(constraint: "max=64")
}

enum DatabaseStatus {
  HEALTHY
  DEGRADED
  UPDATING
  FAILED
  PENDING
  STOPPED
}

type DatabaseTable {
  name: String!
  schema: String!
  estimatedRows: Int!
  columns: [DatabaseColumn!]!
}

type DatabaseColumn {
  name: String!
  type: String!
  nullable: Boolean!
  primaryKey: Boolean!
}

type DatabaseTableData {
  columns: [String!]!
  rows: [[String]]!
  totalEstimatedRows: Int!
}

type QueryResult {
  columns: [String!]!
  rows: [[String]]!
  affectedRows: Int!
}

type DatabaseCredentials {
  type: EndpointType!
  host: String!
  port: String!
  dbname: String!
  user: String!
  password: String!
  uri: String!
}

input CreateDatabaseInput {
  environment: EnvironmentID!
  name: String! @constraint(constraint: "resource_name,min=2,max=16")
  size: String
  resources: ResourcesInput
}

extend type Query {
  """One database, with its status, size and resources."""
  database(id: DatabaseID!): Database! @hasRole(role: WORKSPACE_MEMBER)
  """The tables of a database with their columns, in every schema except the system ones."""
  databaseTables(database: DatabaseID!): [DatabaseTable!]! @hasRole(role: WORKSPACE_MEMBER)
  """Rows of a table, a page at a time. `schema` defaults to `public`, `limit` to 50 and `offset` to 0, and a page holds at most 1,000 rows."""
  databaseTableData(
    database: DatabaseID!
    table: String!
    schema: String
    limit: Int
    offset: Int
  ): DatabaseTableData! @hasRole(role: WORKSPACE_MEMBER)
  """Connection details for a database, password included. There is always an entry for the private hostname inside the environment, and one for the public hostname while the database is exposed."""
  databaseCredentials(database: DatabaseID!): [DatabaseCredentials!]! @hasRole(role: WORKSPACE_MEMBER)
  """The public IPv4 address your requests reach the platform from, or null when it can't be told. Handy for allowing your own machine to connect to a database."""
  clientAddress: String @hasRole(role: WORKSPACE_MEMBER)
}

extend type Mutation {
  """Creates a PostgreSQL database in an environment. `size` defaults to `16Gi`, and CPU and memory to `500m` and `512Mi`."""
  createDatabase(input: CreateDatabaseInput!): Database! @hasRole(role: WORKSPACE_MEMBER)
  """Sets the CPU (250m to 4) and memory (256Mi to 16Gi) of a database."""
  setDatabaseResources(database: DatabaseID!, resources: ResourcesInput!): Database! @hasRole(role: WORKSPACE_MEMBER)
  """Grows the storage of a database to `size`, such as `32Gi`, up to 1Ti. Storage can't shrink."""
  setDatabaseStorage(database: DatabaseID!, size: String!): Database! @hasRole(role: WORKSPACE_MEMBER)
  """Deletes a database and all of its data."""
  deleteDatabase(database: DatabaseID!): Boolean! @hasRole(role: WORKSPACE_MEMBER)
  """Runs one SQL statement against a database, as the user from its credentials, and returns up to 1,000 rows with values as text. The statement commits right away and times out after 30 seconds."""
  executeQuery(database: DatabaseID!, query: String!): QueryResult! @hasRole(role: WORKSPACE_MEMBER)
  """Gives a database a public hostname on port 5432. Clients have to connect with TLS, and nobody can connect until you allow their address with `addDatabaseAllowRule`."""
  exposeDatabase(database: DatabaseID!): Database! @hasRole(role: WORKSPACE_MEMBER)
  """Removes the public hostname of a database, together with its allow rules."""
  unexposeDatabase(database: DatabaseID!): Database! @hasRole(role: WORKSPACE_MEMBER)
  """Allows an address range to connect over the public hostname of an exposed database. Adding a range that is already allowed updates its description."""
  addDatabaseAllowRule(database: DatabaseID!, rule: DatabaseAllowRuleInput!): Database! @hasRole(role: WORKSPACE_MEMBER)
  """Stops allowing an address range. Removing a range that isn't allowed succeeds, and once the last range is gone, nobody can connect over the public hostname."""
  removeDatabaseAllowRule(database: DatabaseID!, range: String! @constraint(constraint: "cidrv4|ipv4")): Database! @hasRole(role: WORKSPACE_MEMBER)
}
