enum ResourceMetric {
  STORAGE_USED
  CPU_USAGE
  MEMORY_USAGE
}

enum MetricUnit {
  BYTES
  CORES
}

enum MetricWindow {
  LAST_1H
  LAST_6H
  LAST_24H
  LAST_7D
  LAST_30D
}

enum MetricGrouping {
  TOTAL
  PER_REPLICA
}

input MetricsRange {
  window: MetricWindow!
}

type MetricPoint {
  timestamp: Time!
  value: Float
}

type MetricSeries {
  metric: ResourceMetric!
  unit: MetricUnit!
  replica: String
  points: [MetricPoint!]!
}
