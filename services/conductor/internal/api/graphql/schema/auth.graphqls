type User {
  name: String
  email: String
  avatarUrl: String!
  workspaces: [WorkspaceMembership!]!
}

type WorkspaceMembership {
  workspace: String!
  role: WorkspaceRole!
}

enum WorkspaceRole {
  USER
  ADMIN
}

extend type Query {
  """The signed-in user, with the workspaces they belong to and their role in each."""
  me: User! @hasRole(role: AUTHENTICATED)
}
