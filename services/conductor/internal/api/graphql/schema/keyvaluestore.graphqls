type KeyValueStore {
  id: KeyValueStoreID!
  """What people read. It can be changed, while `id` stays the same."""
  name: String!
  version: String!
  status: DatabaseStatus!
  size: String!
  createdAt: Time!
}

type KeyValueStoreCredentials {
  type: EndpointType!
  host: String!
  port: String!
  password: String!
  uri: String!
}

input CreateKeyValueStoreInput {
  environment: EnvironmentID!
  """What people read, such as `Sessions`. Any text, and it can be changed later."""
  name: String! @constraint(constraint: "min=1,max=128")
  """The id: 2 to 16 lowercase letters, digits and hyphens, fixed once created. Derived from `name` when left out, with a counter added when that id is taken. A given id that is taken is refused."""
  id: String @constraint(constraint: "resource_name,min=2,max=16")
  size: String
}

extend type Environment {
  keyValueStores: [KeyValueStore!]! @goField(forceResolver: true)
}

extend type Query {
  """One key-value store."""
  keyValueStore(id: KeyValueStoreID!): KeyValueStore! @hasRole(role: WORKSPACE_MEMBER)
  """Connection details for a key-value store, password included. Key-value stores are only reachable inside their environment."""
  keyValueStoreCredentials(keyValueStore: KeyValueStoreID!): [KeyValueStoreCredentials!]! @hasRole(role: WORKSPACE_MEMBER)
}

extend type Mutation {
  """Creates a key-value store in an environment. `size` defaults to `1Gi`, within the limits in `Workspace.capabilities`."""
  createKeyValueStore(input: CreateKeyValueStoreInput!): KeyValueStore! @hasRole(role: WORKSPACE_MEMBER)
  """Deletes a key-value store and its data."""
  deleteKeyValueStore(keyValueStore: KeyValueStoreID!): Boolean! @hasRole(role: WORKSPACE_MEMBER)
  """Changes the name of a key-value store. Its id stays the same, and nothing restarts."""
  renameKeyValueStore(keyValueStore: KeyValueStoreID!, name: String! @constraint(constraint: "min=1,max=128")): KeyValueStore! @hasRole(role: WORKSPACE_MEMBER)
}
