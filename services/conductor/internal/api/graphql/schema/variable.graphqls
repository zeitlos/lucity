type Variable {
  id: VariableID!
  key: String!
  """The value a service linked to this variable receives, read from its source when you ask for it."""
  value: String!
  source: VariableSource!
}

union VariableSource = DatabaseSource | KeyValueStoreSource | BucketSource | SharedSource

type DatabaseSource {
  id: DatabaseID!
  name: String!
}

type KeyValueStoreSource {
  id: KeyValueStoreID!
  name: String!
}

type BucketSource {
  id: BucketID!
  name: String!
}

type SharedSource {
  name: String!
}

type ServiceVariable {
  key: String!
  value: String
  ref: VariableID
}

type SharedVariable {
  key: String!
  value: String!
}

input VariableInput {
  """The name of the variable, such as `PORT` or `HOST`."""
  key: String! @constraint(constraint: "min=1,max=128")
  value: String!
}

input ServiceVariableInput {
  """The name of the variable, such as `PORT` or `HOST`."""
  key: String! @constraint(constraint: "min=1,max=128")
  """A literal value. Set either `value` or `ref`."""
  value: String
  """Links the variable to one from `availableVariables`. Set either `value` or `ref`."""
  ref: VariableID
}

extend type Query {
  """Everything a service in the environment can link to, from its databases, key-value stores, buckets and shared variables."""
  availableVariables(environment: EnvironmentID!): [Variable!]! @hasRole(role: WORKSPACE_MEMBER)
  """The shared variables of an environment."""
  sharedVariables(environment: EnvironmentID!): [SharedVariable!]! @hasRole(role: WORKSPACE_MEMBER)
  """The variables of a service. Linked variables come back with their `ref` instead of a value."""
  serviceVariables(service: ServiceID!): [ServiceVariable!]! @hasRole(role: WORKSPACE_DEPLOYER)
}

extend type Mutation {
  """Replaces all shared variables of an environment with the list given, so keys you leave out are removed. Services that link to a changed key roll out again."""
  setSharedVariables(environment: EnvironmentID!, variables: [VariableInput!]!): Boolean! @hasRole(role: WORKSPACE_MEMBER) @deprecated(reason: "Use `updateSharedVariables`, which changes only the keys you name.")
  """Replaces all variables of a service with the list given, so keys you leave out are removed. The service rolls out again on the image it is already running."""
  setServiceVariables(service: ServiceID!, variables: [ServiceVariableInput!]!): Boolean! @hasRole(role: WORKSPACE_DEPLOYER) @deprecated(reason: "Use `updateServiceVariables`, which changes only the keys you name.")
  """Sets the shared variables in `set` and removes the keys in `unset`. Keys you leave out keep their value. A key may appear once across both lists. Services that link to a changed key roll out again."""
  updateSharedVariables(environment: EnvironmentID!, set: [VariableInput!]! = [], unset: [String!]! = [] @constraint(constraint: "dive,min=1,max=128")): Boolean! @hasRole(role: WORKSPACE_MEMBER)
  """Sets the variables in `set` and removes the keys in `unset`. Keys you leave out keep their value. Setting a key replaces whatever it held, a value or a link. A key may appear once across both lists. The service rolls out again on the image it is already running."""
  updateServiceVariables(service: ServiceID!, set: [ServiceVariableInput!]! = [], unset: [String!]! = [] @constraint(constraint: "dive,min=1,max=128")): Boolean! @hasRole(role: WORKSPACE_DEPLOYER)
}
