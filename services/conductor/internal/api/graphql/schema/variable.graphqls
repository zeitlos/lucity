type Variable {
  id: VariableID!
  key: String!
  source: VariableSource!
}

union VariableSource = DatabaseSource | KeyValueStoreSource | BucketSource | SharedSource

type DatabaseSource {
  id: DatabaseID!
  name: String!
}

type KeyValueStoreSource {
  id: KeyValueStoreID!
  name: String!
}

type BucketSource {
  id: BucketID!
  name: String!
}

type SharedSource {
  name: String!
}

type ServiceVariable {
  key: String!
  value: String
  ref: VariableID
}

type SharedVariable {
  key: String!
  value: String!
}

input VariableInput {
  """Key of the variable. e.g. PORT or HOST"""
  key: String! @constraint(constraint: "min=1,max=128")
  value: String!
}

input ServiceVariableInput {
  """Key of the variable. e.g. PORT or HOST"""
  key: String! @constraint(constraint: "min=1,max=128")
  """Literal value. Required when no ref is set. Mutually exclusive with ref."""
  value: String
  """Reference to an available variable. Required when no value is set. Mutually exclusive with value."""
  ref: VariableID
}

extend type Query {
  availableVariables(environment: EnvironmentID!): [Variable!]! @hasRole(role: WORKSPACE_MEMBER)
  sharedVariables(environment: EnvironmentID!): [SharedVariable!]! @hasRole(role: WORKSPACE_MEMBER)
  serviceVariables(service: ServiceID!): [ServiceVariable!]! @hasRole(role: WORKSPACE_DEPLOYER)
}

extend type Mutation {
  setSharedVariables(environment: EnvironmentID!, variables: [VariableInput!]!): Boolean! @hasRole(role: WORKSPACE_MEMBER)
  setServiceVariables(service: ServiceID!, variables: [ServiceVariableInput!]!): Boolean! @hasRole(role: WORKSPACE_DEPLOYER)
}
