type Variable {
  key: String!
  value: String!
}

"""A reference to a CNPG database secret key (resolved at pod startup via secretKeyRef)."""
type DatabaseRef {
  database: DatabaseID!
  key: String!
}

"""A reference to another service's internal URL (computed by Helm template)."""
type ServiceRef {
  service: ServiceID!
}

input DatabaseRefInput {
  database: DatabaseID!
  key: String!
}

input ServiceRefInput {
  service: ServiceID!
}

type ServiceVariable {
  key: String!
  value: String!
  fromShared: Boolean!
  databaseRef: DatabaseRef
  serviceRef: ServiceRef
}

input VariableInput {
  key: String!
  value: String!
}

input ServiceVariableInput {
  key: String!
  """Direct value. Required when no ref is set."""
  value: String
  """If true, value is resolved from the shared variable with the same key."""
  fromShared: Boolean
  """Reference to a database secret key."""
  databaseRef: DatabaseRefInput
  """Reference to another service's internal URL."""
  serviceRef: ServiceRefInput
}

extend type Query {
  sharedVariables(environment: EnvironmentID!): [Variable!]! @hasRole(role: [USER])
  serviceVariables(service: ServiceID!): [ServiceVariable!]! @hasRole(role: [USER])
}

extend type Mutation {
  setSharedVariables(environment: EnvironmentID!, variables: [VariableInput!]!): Boolean! @hasRole(role: [USER])
  setServiceVariables(service: ServiceID!, variables: [ServiceVariableInput!]!): Boolean! @hasRole(role: [USER])
}
