directive @hasRole(role: Role!) on FIELD_DEFINITION
directive @allowSuspended on FIELD_DEFINITION
directive @constraint(constraint: String!) on INPUT_FIELD_DEFINITION | ARGUMENT_DEFINITION
directive @goModel(model: String, models: [String!]) on OBJECT | INPUT_OBJECT | SCALAR | ENUM | INTERFACE | UNION
directive @goField(forceResolver: Boolean, name: String, omittable: Boolean) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION
directive @goExtraField(name: String, type: String!, overrideTags: String, description: String) repeatable on OBJECT | INPUT_OBJECT
directive @goTag(key: String!, value: String!) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION

scalar Time
scalar Duration

scalar ProjectID
scalar EnvironmentID
scalar ServiceID
scalar DeploymentID
scalar DatabaseID
scalar KeyValueStoreID
scalar VolumeID
scalar BucketID
scalar BuildID
scalar DeployID
scalar ScanID
scalar ReleaseID
scalar VariableID

enum Role {
  ANONYMOUS
  AUTHENTICATED
  WORKSPACE_DEPLOYER
  WORKSPACE_MEMBER
  WORKSPACE_ADMIN
}

type Query

type Mutation

type Subscription
