type Build {
  id: String!
  status: BuildStatus!

  startedAt: Time!
  finishedAt: Time
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

extend type Query {
  build(id: String!): Build! @hasRole(role: WORKSPACE_MEMBER)
}

extend type Subscription {
  buildLogs(id: String!): String! @hasRole(role: WORKSPACE_MEMBER)
}