type EjectArtifact {
  filename: String!
  contentType: String!
  """Base64-encoded zip archive of the ejected project."""
  content: String!
}

extend type Query {
  """Exports a project as a zip archive, base64-encoded, holding a Helm chart, a values file for each environment and install instructions. The project keeps running. The values include variables and passwords, so treat the archive as a secret."""
  ejectProject(id: ProjectID!): EjectArtifact! @hasRole(role: WORKSPACE_MEMBER)
}
