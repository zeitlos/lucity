type Service {
  id: ServiceID!
  name: String!

  status: ServiceStatus!
  replicas: ReplicaCount!
  autoscaling: AutoscalingSettings
  endpoints: [Endpoint!]!

  sourceUrl: String!
  contextPath: String!
  resources: Resources!
  command: String!
  defaultCommand: String! @goField(forceResolver: true)

  activeDeployment: Deployment
  deployments: [Deployment!]! @goField(forceResolver: true)

  builds: [Build!]! @goField(forceResolver: true)

  lastDeployedAt: Time
  createdAt: Time!
}

type ReplicaCount {
  desired: Int!
  ready: Int!
}

type AutoscalingSettings {
  minReplicas: Int!
  maxReplicas: Int!
  targetCpu: Int!
}

type Resources {
  cpu: String!
  memory: String!
}

type Endpoint {
  host: String!
  port: Int!
  protocol: Protocol!
}

enum Protocol {
  HTTP
  HTTPS
  TCP
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  DEPLOYING
  FAILED
  STOPPED
}

type ServiceResources {
  cpuMillicores: Int!
  memoryMB: Int!
  cpuLimitMillicores: Int!
  memoryLimitMB: Int!
}

type ScalingConfig {
  replicas: Int!
  autoscaling: AutoscalingConfig
}

type AutoscalingConfig {
  enabled: Boolean!
  minReplicas: Int!
  maxReplicas: Int!
  targetCPU: Int!
}

type Domain {
  hostname: String!
  """PLATFORM domains use wildcard DNS on the workload domain. CUSTOM domains require user DNS config."""
  type: DomainType!
  """DNS resolution status. Always VALID for platform domains. Checked via DNS lookup for custom domains."""
  dnsStatus: DnsStatus!
  """TLS certificate status. NONE for platform domains (covered by wildcard). Checked via cert-manager for custom domains."""
  tlsStatus: TlsStatus!
}

enum TlsStatus {
  NONE
  PROVISIONING
  ACTIVE
  ERROR
}

enum DomainType {
  PLATFORM
  CUSTOM
}

enum DnsStatus {
  VALID
  PENDING
  MISCONFIGURED
  ERROR
}

type DetectedService {
  name: String!
  language: String!
  framework: String!
  startCommand: String!
  suggestedPort: Int!
}

input AddServiceInput {
  environment: EnvironmentID!
  """Service name. If omitted when image is set, derived from the image (e.g. nginx:1.25 → nginx)."""
  name: String @constraint(constraint: "resource_name,min=2,max=63")
  """Container port. If omitted when image is set, uses well-known defaults (e.g. redis → 6379)."""
  port: Int
  framework: String
  """Auto-detected start command from the build system (e.g. railpack). Stored for UI display as the default."""
  startCommand: String
  """GitHub repository in owner/repo format (e.g. "acme/myapp"). Requires installationId. The clone URL is constructed server-side."""
  repository: String @constraint(constraint: "min=3,max=200")
  contextPath: String
  """GitHub App installation ID. Required when repository is set."""
  installationId: ID
  """External container image reference (e.g. nginx:1.25, ghcr.io/foo/bar:v1). Skips the build step."""
  image: String
  """Custom command to start the service (e.g. "npm run start", "stress --cpu 2 --timeout 60s"). Overrides the image entrypoint."""
  customStartCommand: String
}

"""Result of a live DNS verification for a custom domain."""
type DnsCheck {
  hostname: String!
  """Current DNS status after live lookup."""
  status: DnsStatus!
  """The CNAME target found in DNS, if any."""
  cnameTarget: String
  """The expected CNAME target for this platform."""
  expectedTarget: String!
  """Human-readable message explaining the current status."""
  message: String
  """TLS certificate provisioning status for custom domains."""
  tlsStatus: TlsStatus
}

input SetServiceScalingInput {
  service: ServiceID!
  replicas: Int! @constraint(constraint: "min=1,max=20")
  autoscaling: AutoscalingInput
}

input AutoscalingInput {
  enabled: Boolean!
  minReplicas: Int! @constraint(constraint: "min=1,max=20")
  maxReplicas: Int! @constraint(constraint: "min=1,max=20")
  targetCPU: Int! @constraint(constraint: "min=10,max=95")
}

extend type Query {
  service(id: ServiceID!): Service! @hasRole(role: [USER])
  detectServices(installationId: ID!, repositoryUrl: String!): [DetectedService!]! @hasRole(role: [USER])
  checkDnsStatus(hostname: String!): DnsCheck! @hasRole(role: [USER])
}

extend type Mutation {
  addService(input: AddServiceInput!): Service! @hasRole(role: [USER])
  removeService(service: ServiceID!): Boolean! @hasRole(role: [USER])
  setCustomStartCommand(service: ServiceID!, command: String!): Service! @hasRole(role: [USER])
  setServiceScaling(input: SetServiceScalingInput!): Service! @hasRole(role: [USER])
  rollback(deployment: DeploymentID!): Boolean! @hasRole(role: [USER])
  generateDomain(service: ServiceID!): Service! @hasRole(role: [USER])
  addCustomDomain(service: ServiceID!, hostname: String! @constraint(constraint: "min=4,max=253")): Service! @hasRole(role: [USER])
  removeDomain(service: ServiceID!, hostname: String!): Service! @hasRole(role: [USER])
}
