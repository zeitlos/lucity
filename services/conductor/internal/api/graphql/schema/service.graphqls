type DetectedService {
  name: String!
  language: String!
  framework: String!
  startCommand: String!
  suggestedPort: Int!
}

input AddServiceInput {
  environment: EnvironmentID!
  """Service name. If omitted when image is set, derived from the image (e.g. nginx:1.25 → nginx)."""
  name: String @constraint(constraint: "resource_name,min=2,max=63")
  """Container port. If omitted when image is set, uses well-known defaults (e.g. redis → 6379)."""
  port: Int
  framework: String
  """Auto-detected start command from the build system (e.g. railpack). Stored for UI display as the default."""
  startCommand: String
  """GitHub repository in owner/repo format (e.g. "acme/myapp"). Requires installationId. The clone URL is constructed server-side."""
  repository: String @constraint(constraint: "min=3,max=200")
  contextPath: String
  """GitHub App installation ID. Required when repository is set."""
  installationId: ID
  """External container image reference (e.g. nginx:1.25, ghcr.io/foo/bar:v1). Skips the build step."""
  image: String
  """Custom command to start the service (e.g. "npm run start", "stress --cpu 2 --timeout 60s"). Overrides the image entrypoint."""
  customStartCommand: String
}

type DeployRun {
  id: ID!
  phase: DeployPhase!
  buildId: String
  imageRef: String
  digest: String
  error: String
  """When the deploy operation started."""
  startedAt: Time
  """Rollout health status from the deployment system."""
  rolloutHealth: SyncStatus
  """Rollout status detail, e.g. ImagePullBackOff, CrashLoopBackOff."""
  rolloutMessage: String
}

enum DeployPhase {
  QUEUED
  CLONING
  BUILDING
  PUSHING
  DEPLOYING
  SUCCEEDED
  FAILED
}

"""Result of a live DNS verification for a custom domain."""
type DnsCheck {
  hostname: String!
  """Current DNS status after live lookup."""
  status: DnsStatus!
  """The CNAME target found in DNS, if any."""
  cnameTarget: String
  """The expected CNAME target for this platform."""
  expectedTarget: String!
  """Human-readable message explaining the current status."""
  message: String
  """TLS certificate provisioning status for custom domains."""
  tlsStatus: TlsStatus
}

extend type Query {
  detectServices(installationId: ID!, repository: String!): [DetectedService!]! @hasRole(role: [USER])
  deployStatus(id: ID!): DeployRun @hasRole(role: [USER])
  activeDeployment(service: ServiceID!): DeployRun @hasRole(role: [USER])
  platformConfig: PlatformConfig! @hasRole(role: [USER])
  checkDnsStatus(hostname: String!): DnsCheck! @hasRole(role: [USER])
}

extend type Mutation {
  addService(input: AddServiceInput!): ServiceInstance! @hasRole(role: [USER])
  removeService(service: ServiceID!): Boolean! @hasRole(role: [USER])
  setCustomStartCommand(service: ServiceID!, command: String!): Boolean! @hasRole(role: [USER])
  deploy(service: ServiceID!, gitRef: String): DeployRun! @hasRole(role: [USER])
  rollback(service: ServiceID!, imageTag: String!): Boolean! @hasRole(role: [USER])
  generateDomain(service: ServiceID!): Domain! @hasRole(role: [USER])
  addCustomDomain(service: ServiceID!, hostname: String! @constraint(constraint: "min=4,max=253")): Domain! @hasRole(role: [USER])
  removeDomain(service: ServiceID!, hostname: String!): Boolean! @hasRole(role: [USER])
}

extend type Subscription {
  deployLogs(id: ID!): String! @hasRole(role: [USER])
}
