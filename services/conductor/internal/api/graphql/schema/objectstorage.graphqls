type Bucket {
  id: BucketID!
  name: String!
  region: String!
  endpoint: String!
  publicEndpoint: String!
  status: BucketStatus!
  sizeBytes: Int!
  objectCount: Int!
  public: Boolean!
  createdAt: Time!
}

enum BucketStatus {
  READY
  PENDING
  FAILED
}

type BucketCredentials {
  endpoint: String!
  region: String!
  bucket: String!
  accessKeyId: String!
  secretAccessKey: String!
}

type BucketObject {
  key: String!
  size: Int!
  lastModified: Time!
}

type BucketFolder {
  prefix: String!
}

type BucketObjectListing {
  prefix: String!
  folders: [BucketFolder!]!
  objects: [BucketObject!]!
}

input CreateBucketInput {
  environment: EnvironmentID!
  name: String! @constraint(constraint: "resource_name,min=2,max=16")
}

extend type Environment {
  buckets: [Bucket!]! @goField(forceResolver: true)
}

extend type Query {
  bucket(id: BucketID!): Bucket! @hasRole(role: WORKSPACE_MEMBER)
  bucketCredentials(bucket: BucketID!): BucketCredentials! @hasRole(role: WORKSPACE_MEMBER)
  bucketObjects(
    bucket: BucketID!
    prefix: String @constraint(constraint: "max=1024")
  ): BucketObjectListing! @hasRole(role: WORKSPACE_MEMBER)
  bucketObjectDownloadUrl(
    bucket: BucketID!
    key: String! @constraint(constraint: "min=1,max=1024")
  ): String! @hasRole(role: WORKSPACE_MEMBER)
}

extend type Mutation {
  createBucket(input: CreateBucketInput!): Bucket! @hasRole(role: WORKSPACE_MEMBER)
  deleteBucket(bucket: BucketID!): Boolean! @hasRole(role: WORKSPACE_MEMBER)
  setBucketPublic(bucket: BucketID!, public: Boolean!): Bucket! @hasRole(role: WORKSPACE_MEMBER)
  bucketObjectUploadUrl(
    bucket: BucketID!
    key: String! @constraint(constraint: "min=1,max=1024")
  ): String! @hasRole(role: WORKSPACE_MEMBER)
  deleteBucketObject(
    bucket: BucketID!
    key: String! @constraint(constraint: "min=1,max=1024")
  ): Boolean! @hasRole(role: WORKSPACE_MEMBER)
}
