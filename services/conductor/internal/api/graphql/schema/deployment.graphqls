type Deployment {
  id: DeploymentID!

  image: String!
  imageDigest: String

  commit: String!
  commitMessage: String!
  ref: String!
  sourceUrl: String!
  contextPath: String!

  resources: Resources!
  command: String!

  buildId: String!

  status: DeploymentStatus!
  replicas: ReplicaCount!
  rollout: Rollout

  createdAt: Time!
}

enum DeploymentStatus {
  DEPLOYING
  ACTIVE
  SUPERSEDED
  FAILED
}

type Rollout {
  status: RolloutStatus!
  reason: RolloutReason
  message: String
  restarts: Int!
  startedAt: Time!
}

enum RolloutStatus {
  PROGRESSING
  READY
  DEGRADED
  FAILED
  SUPERSEDED
}

enum RolloutReason {
  CRASH_LOOP
  OOM_KILLED
  IMAGE_PULL_FAILED
  CONFIG_ERROR
  QUOTA_EXCEEDED
  UNSCHEDULABLE
  NOT_READY
  DEADLINE_EXCEEDED
}

extend type Query {
  deployment(id: DeploymentID!): Deployment! @hasRole(role: WORKSPACE_MEMBER)
}

extend type Mutation {
  deploy(service: ServiceID!, gitRef: String): Release! @hasRole(role: WORKSPACE_DEPLOYER)
}