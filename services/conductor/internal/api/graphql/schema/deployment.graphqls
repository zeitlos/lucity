type Deployment {
  id: DeploymentID!

  image: String!
  imageDigest: String

  commit: String!
  commitMessage: String!
  ref: String!
  sourceUrl: String!
  contextPath: String!

  resources: Resources!
  command: String!

  buildId: String!
  deployedBy: String!

  status: DeploymentStatus!
  replicas: ReplicaCount!

  createdAt: Time!
}

enum DeploymentStatus {
  DEPLOYING
  ACTIVE
  SUPERSEDED
  FAILED
}
