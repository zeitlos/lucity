type Deployment @goExtraField(name: "GitHubInstallationID", type: "string") {
  id: DeploymentID!

  image: String!
  imageDigest: String

  commit: String!
  commitMessage: String! @goField(forceResolver: true)
  ref: String!
  sourceUrl: String!
  contextPath: String!

  resources: Resources!
  command: String!

  buildId: String!
  deployedBy: String!

  status: DeploymentStatus!
  replicas: ReplicaCount!

  createdAt: Time!
}

enum DeploymentStatus {
  DEPLOYING
  ACTIVE
  SUPERSEDED
  FAILED
}

extend type Query {
  deployment(id: DeploymentID!): Deployment! @hasRole(role: [USER])
}