"""A public container image on Docker Hub."""
type ImageSearchResult {
  name: String!
  description: String!
  starCount: Int!
  pullCount: Int!
  official: Boolean!
}

extend type Query {
  """Public container images on Docker Hub that match `query`."""
  searchImages(query: String!): [ImageSearchResult!]! @hasRole(role: WORKSPACE_MEMBER)
}
