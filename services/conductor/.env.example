# ---------------------------------------------------------------------------
# Service ports + logging
# ---------------------------------------------------------------------------
PORT=8080
GRPC_PORT=9090
WEBHOOK_PORT=9004
LOG_LEVEL=info
LOG_COLOR=true

# ---------------------------------------------------------------------------
# OIDC (Logto) — authenticates dashboard users via PKCE
# ---------------------------------------------------------------------------
# [required] Public issuer URL (what's in the JWT iss claim).
OIDC_ISSUER_URL=https://id.lucity.cloud
# Optional: cluster-internal URL for discovery + token exchange,
# avoids hairpin routing when conductor and Logto live in the same cluster.
# Falls back to OIDC_ISSUER_URL when empty.
# OIDC_DISCOVERY_URL=http://logto-core.lucity-system.svc.cluster.local:3001/oidc

# [required] OIDC client ID for the dashboard app.
OIDC_CLIENT_ID=
# Where Logto sends users back after sign-in. Match what's registered in Logto.
OIDC_CALLBACK_URL=http://localhost:8080/auth/callback

# ---------------------------------------------------------------------------
# Auth — session JWT + dashboard URL
# ---------------------------------------------------------------------------
DASHBOARD_URL=http://localhost:5173

# [required] HMAC-SHA256 secret used to sign session JWTs minted by
# conductor after a successful OIDC login. 32+ random bytes in prod.
SESSION_SECRET=change-me-in-production

# Optional: test-mode auth secret. When set, replaces SESSION_SECRET
# (so test JWTs verify). Never set in production.
# AUTH_TEST_SECRET=

# ---------------------------------------------------------------------------
# Logto Management API (M2M)
# ---------------------------------------------------------------------------
# [required] Used to read+write workspace metadata (org customData),
# resolve member roles, etc.
LOGTO_ENDPOINT=http://localhost:3002
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# ---------------------------------------------------------------------------
# Cashier (billing) — optional
# ---------------------------------------------------------------------------
# When empty, billing is disabled (workspace creation skips checkout,
# Stripe-related GraphQL fields return errors). Set to the cashier
# gRPC service address to enable.
# CASHIER_ADDR=localhost:9005

# ---------------------------------------------------------------------------
# Webhook (GitHub events)
# ---------------------------------------------------------------------------
# Shared secret used to validate inbound GitHub webhook signatures.
# Must match the secret configured on the GitHub App.
WEBHOOK_SECRET=dev-secret

# ---------------------------------------------------------------------------
# Soft-serve (GitOps repo storage)
# ---------------------------------------------------------------------------
SOFTSERVE_SSH_ADDR=localhost:23231
SOFTSERVE_HTTP_ADDR=http://localhost:23232

# Cluster-internal URL ArgoCD uses to clone GitOps repos. Falls back
# to SOFTSERVE_HTTP_ADDR when empty. Set this in dev when
# SOFTSERVE_HTTP_ADDR is a port-forward.
# SOFTSERVE_CLUSTER_HTTP_ADDR=http://lucity-infra-soft-serve.lucity-system.svc.cluster.local:23232

# [required] SSH private key authorized on Soft-serve as admin.
# Used for repo create/delete/list operations.
SOFTSERVE_SSH_KEY_PATH=/path/to/admin-key

# Soft-serve HTTP access token for git clone/push.
# Create with: ssh -i <key> -o IdentitiesOnly=yes -p 23231 localhost token create 'conductor'
# SOFTSERVE_TOKEN=

# ---------------------------------------------------------------------------
# ArgoCD
# ---------------------------------------------------------------------------
# [required] HTTP(S) endpoint for the ArgoCD API server.
ARGOCD_ADDR=http://localhost:8443
# [required] API token. Generate via `argocd account generate-token`.
ARGOCD_TOKEN=
# When true, skip TLS verification (dev only).
ARGOCD_INSECURE=false

# ---------------------------------------------------------------------------
# Cluster (Gateway API + cert-manager + registry pull)
# ---------------------------------------------------------------------------
# Gateway resource that user workloads' HTTPRoutes attach to.
GATEWAY_NAME=lucity-gateway
GATEWAY_NAMESPACE=lucity-system

# cert-manager ClusterIssuer for custom-domain TLS certs.
CLUSTER_ISSUER=letsencrypt-http01

# Source dockerconfigjson Secret in the platform namespace. Conductor
# clones this Secret into each workload namespace so kubelet can pull
# from the OCI registry.
REGISTRY_PULL_SECRET=lucity-registry-pull

# ---------------------------------------------------------------------------
# Build orchestration
# ---------------------------------------------------------------------------
# Push address used by build Jobs. Local dev points at port-forwarded
# Zot; in prod this is the cluster service DNS name.
REGISTRY_URL=localhost:5000

# Cluster-internal address embedded in image refs in Helm values.
# Different from REGISTRY_URL when conductor is reached via
# port-forward but workloads pull from the cluster IP. Falls back to
# REGISTRY_URL when empty.
# For minikube: REGISTRY_IMAGE_PREFIX=10.96.100.50:5000
# For prod:    REGISTRY_IMAGE_PREFIX=lucity-infra-zot.lucity-system.svc.cluster.local:5000
# REGISTRY_IMAGE_PREFIX=

# Registry credentials used by build Jobs to push images. Optional in
# dev (Zot runs without auth); required in prod.
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=
# Name of an in-cluster Secret holding registry auth, mounted into
# build pods. Optional alternative to USERNAME+PASSWORD.
# REGISTRY_AUTH_SECRET=lucity-registry-auth

# When true, BuildKit pushes images over HTTP (no TLS verify).
REGISTRY_INSECURE=true

# Working directory inside the conductor pod for build orchestration
# scratch (clone+stage paths).
WORK_DIR=/tmp/lucity-builds

# [required for builds] Container image for build Job pods. Set this
# to the services/builder/ image. Without it, builds fail at submit.
BUILD_IMAGE=ghcr.io/zeitlos/lucity/builder:<tag>

# BuildKit gRPC address. Build Jobs connect here to submit LLB.
# BUILDKIT_ADDR=tcp://lucity-buildkit.lucity-builds.svc.cluster.local:1234

# Namespace where build Jobs (and the BuildKit Deployment) live.
BUILD_NAMESPACE=lucity-builds

# ---------------------------------------------------------------------------
# GitHub App — installation tokens (repo cloning) + OAuth (user login)
# ---------------------------------------------------------------------------
# Optional. When unset, repo listing + commit enrichment are disabled
# and webhook receivers reject events. Required for the source-build
# flow to work end-to-end.
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY_PATH=/secrets/github/private-key.pem
# GITHUB_APP_SLUG=lucity-platform
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/auth/github/callback

# ---------------------------------------------------------------------------
# Domains
# ---------------------------------------------------------------------------
# [required] Base domain for platform-generated workload hostnames
# ({service}-{env}.<workload-domain>).
WORKLOAD_DOMAIN=lucity.local

# [required] Base domain for platform-generated database hostnames
# ({database}-{env}.<database-domain>), routed by Traefik SNI on :5432.
DATABASE_DOMAIN=db.lucity.local

# Optional: load balancer IP shown to users for A-record setup of
# custom domains. Cosmetic.
# IP_ADDRESS=

# ---------------------------------------------------------------------------
# Reconciliation
# ---------------------------------------------------------------------------
# Background loops that re-apply releases and sync the gateway. Defaults to
# true. Set to false when pointing a local dev binary at a shared/prod cluster
# so it never reconciles releases another conductor owns.
# RECONCILE_ENABLED=true

# ---------------------------------------------------------------------------
# Internal JWT (ES256) — service-to-service auth
# ---------------------------------------------------------------------------
# Used for:
#   - signing outgoing calls to cashier (private key)
#   - verifying inbound calls from cashier on :9090 (public key)
#
# Generate both with: make generate-internal-keys
#
# Optional in dev (when CASHIER_ADDR is unset and no inbound gRPC is
# expected). Required in prod.
# INTERNAL_JWT_PRIVATE_KEY_PATH=../../internal-jwt-private.pem
# INTERNAL_JWT_PUBLIC_KEY_PATH=../../internal-jwt-public.pem
