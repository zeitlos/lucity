# Cashier service configuration
LOG_LEVEL=info
LOG_COLOR=true

# Logto Management API (M2M), read-only use: workspace discovery
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_M2M_APP_ID=<app-id>
LOGTO_M2M_APP_SECRET=<app-secret>

# Stripe
STRIPE_SECRET_KEY=sk_test_...

# Stripe plan Price IDs, for the monthly plan credit
STRIPE_HOBBY_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# Billing Meter event names (create Billing Meters in Stripe Dashboard)
STRIPE_ECO_CPU_METER_EVENT=eco_cpu_usage
STRIPE_ECO_MEM_METER_EVENT=eco_memory_usage
STRIPE_ECO_DISK_METER_EVENT=eco_disk_usage
STRIPE_STORAGE_METER_EVENT=object_storage_usage
STRIPE_EGRESS_METER_EVENT=egress_usage

# Metering
METERING_INTERVAL=1h
VICTORIA_METRICS_URL=http://localhost:8428

# Kubernetes access for the environment namespaces and the metering checkpoint:
# in-cluster config, or KUBECONFIG when run locally.
