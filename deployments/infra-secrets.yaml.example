# Copy to deployments/<env>/infra-secrets.yaml and fill in what that environment enables.

zot:
  configFiles:
    htpasswd: ""          # htpasswd -bBn builder <password> and htpasswd -bBn reader <password>, one line each

logto:
  secrets:
    secretVaultKek: ""    # openssl rand -base64 32, never change it once Logto has started

grafanaOIDC:
  clientSecret: ""        # Logto app "Grafana" (Traditional Web), its client ID goes in infra-values.yaml

alertingTelegram:
  botToken: ""

# The whole receiver, because Helm replaces lists instead of merging them.
victoria-metrics-alert:
  alertmanager:
    config:
      receivers:
        - name: telegram
          telegram_configs:
            - bot_token_file: /etc/alertmanager/secrets/bot_token
              chat_id: 0              # for a group with Topics: -100 followed by the digits in its t.me/c/ link
              message_thread_id: 0    # topic ID, 0 without Topics
              parse_mode: HTML
              send_resolved: true
              message: '{{ template "lucity.telegram" . }}'

rybbit:
  secrets:
    clickhousePassword: ""    # openssl rand -hex 16
    betterAuthSecret: ""      # openssl rand -hex 32
    redisPassword: ""         # openssl rand -hex 16

backups:
  credentials:                # platform backup bucket only, not the database backup keys
    accessKeyId: ""
    secretAccessKey: ""
    region: ""

hcloud-exporter:
  config:
    token: ""                 # read-only Hetzner API token
