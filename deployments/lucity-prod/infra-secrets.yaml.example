# Infrastructure secrets for production deployment.
# Copy to infra-secrets.yaml and fill in actual values.
# infra-secrets.yaml is gitignored — never commit it.

# Zot OCI Registry
zot:
  configFiles:
    # Two users: builder (push) and reader (pull for workload imagePullSecrets).
    # htpasswd -bBn builder "$(openssl rand -hex 16)" > /tmp/htpasswd
    # htpasswd -bBn reader "$(openssl rand -hex 16)" >> /tmp/htpasswd
    # cat /tmp/htpasswd
    htpasswd: ""

# Soft-serve Git Server
softServe:
  initialAdminKey: ""        # cat ~/.ssh/lucity-admin-prod.pub

# Rybbit Analytics
rybbit:
  secrets:
    clickhousePassword: ""   # openssl rand -hex 16
    betterAuthSecret: ""     # openssl rand -hex 32

# Logto Identity Provider
logto:
  secrets:
    m2mAppId: ""             # from Logto admin → Applications → M2M app → App ID
    m2mAppSecret: ""         # from Logto admin → Applications → M2M app → App Secret

# Grafana OIDC (Logto)
# Create a Logto application of type "Traditional Web" named "Grafana".
# Redirect URIs:
#   http://localhost:3000/login/generic_oauth   (port-forward)
# Copy the App ID into infra-values.yaml at: grafana.grafana.ini.auth.generic_oauth.client_id
# Copy the App Secret here:
grafanaOIDC:
  clientSecret: ""

# Alertmanager — Telegram
# 1. Create a bot via @BotFather; copy the token (e.g. 123456:ABC-DEF...)
# 2. Add the bot to a channel/group; get chat ID via:
#      curl https://api.telegram.org/bot<TOKEN>/getUpdates
#    (group/channel IDs are negative; user DM IDs are positive)
alertingTelegram:
  botToken: ""               # from BotFather

# Override the Telegram receiver with the real chat ID.
# This block needs to be present because Helm replaces (not merges) lists,
# so we redefine the entire receiver to set chat_id while keeping bot_token_file.
victoria-metrics-alert:
  alertmanager:
    config:
      receivers:
        - name: telegram
          telegram_configs:
            - bot_token_file: /etc/alertmanager/secrets/bot_token
              chat_id: 0     # replace with real numeric chat ID (e.g. -1001234567890)
              parse_mode: HTML
              send_resolved: true
