# Copy to deployments/<env>/secrets.yaml.

secrets:
  SESSION_SECRET: ""                          # openssl rand -hex 32
  GITHUB_CLIENT_SECRET: ""
  GITHUB_WEBHOOK_SECRET: ""
  LOGTO_M2M_APP_ID: ""
  LOGTO_M2M_APP_SECRET: ""
  REGISTRY_PASSWORD: ""                       # builder password from the Zot htpasswd
  OVH_APPLICATION_KEY: ""
  OVH_APPLICATION_SECRET: ""
  OVH_CONSUMER_KEY: ""
  EXPORTER_OVH_APPLICATION_KEY: ""            # exporter, read-only token: GET /cloud/project/<projectId>/region/*
  EXPORTER_OVH_APPLICATION_SECRET: ""
  EXPORTER_OVH_CONSUMER_KEY: ""
  STRIPE_SECRET_KEY: ""                       # billing only
  STRIPE_WEBHOOK_SECRET: ""                   # billing only
  BUNNY_API_KEY: ""                           # optional, public bucket CDN and workload edge
  EDGE_HEADER_SECRET: ""                      # optional, openssl rand -hex 32; the edge sets it, workload routes require it
  DATABASE_BACKUP_S3_ACCESS_KEY_ID: ""        # optional, database backups
  DATABASE_BACKUP_S3_SECRET_ACCESS_KEY: ""    # optional, database backups

githubPrivateKey: |
  -----BEGIN RSA PRIVATE KEY-----
  ...
  -----END RSA PRIVATE KEY-----

registryPull:
  password: ""                                # reader password from the Zot htpasswd

internalJWT:                                  # make generate-internal-keys
  privateKey: |
    -----BEGIN EC PRIVATE KEY-----
    ...
    -----END EC PRIVATE KEY-----
  publicKey: |
    -----BEGIN PUBLIC KEY-----
    ...
    -----END PUBLIC KEY-----
