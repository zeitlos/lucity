# Infrastructure secrets for the lucity-dev deployment.
# Copy to infra-secrets.yaml and fill in actual values.
# infra-secrets.yaml is gitignored — never commit it.

# Zot OCI Registry
zot:
  configFiles:
    # Two users: builder (push, used by BuildKit) and reader (pull, used by
    # workload imagePullSecrets). No anonymous access.
    # htpasswd -bBn builder "$(openssl rand -hex 16)" > /tmp/htpasswd
    # htpasswd -bBn reader "$(openssl rand -hex 16)" >> /tmp/htpasswd
    # cat /tmp/htpasswd
    htpasswd: ""

# Logto Identity Provider
logto:
  secrets:
    m2mAppId: ""           # Logto admin → Applications → M2M app → App ID
    m2mAppSecret: ""       # Logto admin → Applications → M2M app → App Secret
    secretVaultKek: ""     # openssl rand -base64 32 (encrypts stored GitHub tokens)

# Grafana OIDC (Logto)
# In the dev Logto (id.lucity.dev), create an application of type "Traditional Web" named "Grafana".
# Redirect URI: http://localhost:3000/login/generic_oauth   (port-forward)
# Copy the App ID into infra-values.yaml at: grafana.grafana.ini.auth.generic_oauth.client_id
# Copy the App Secret here. Signing in needs the lucity-system-admin role on your Logto user.
grafanaOIDC:
  clientSecret: ""

# Alertmanager to Telegram
# 1. Create a dev bot via @BotFather and copy the token.
# 2. Create a group, turn on Topics, add the bot as an admin, and create an "Alerts" topic.
# 3. A topic link looks like https://t.me/c/1234567890/2, meaning chat ID -1001234567890 and topic ID 2.
alertingTelegram:
  botToken: ""

# Helm replaces lists instead of merging them, so the whole receiver is redefined here.
victoria-metrics-alert:
  alertmanager:
    config:
      receivers:
        - name: telegram
          telegram_configs:
            - bot_token_file: /etc/alertmanager/secrets/bot_token
              chat_id: 0
              message_thread_id: 0
              parse_mode: HTML
              send_resolved: true
              message: |-
                <b>{{ .Status | toUpper }}: {{ .CommonLabels.alertname }}</b> ({{ .CommonLabels.severity }})
                {{ range .Alerts }}
                {{ .Annotations.summary }}
                {{- with .Labels.namespace }}
                • namespace: <code>{{ . }}</code>{{ end }}
                {{- with .Labels.pod }}
                • pod: <code>{{ . }}</code>{{ end }}
                {{- with .Labels.container }}
                • container: <code>{{ . }}</code>{{ end }}
                {{- with .Labels.node }}
                • node: <code>{{ . }}</code>{{ end }}
                {{- with .Labels.persistentvolumeclaim }}
                • pvc: <code>{{ . }}</code>{{ end }}
                {{- with .Labels.name }}
                • name: <code>{{ . }}</code>{{ end }}
                {{- with .Labels.reason }}
                • reason: <code>{{ . }}</code>{{ end }}
                {{- with .Labels.job }}
                • job: <code>{{ . }}</code>{{ end }}
                {{ end }}
