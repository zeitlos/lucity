# Platform secrets for the lucity-dev deployment.
# Copy to secrets.yaml and fill in actual values.
# secrets.yaml is gitignored — never commit it.

secrets:
  GITHUB_WEBHOOK_SECRET: ""    # from the dev GitHub App settings
  GITHUB_CLIENT_SECRET: ""     # from the dev GitHub App → Client secrets
  REGISTRY_PASSWORD: ""        # builder password from the Zot htpasswd
  SESSION_SECRET: ""           # openssl rand -hex 32 (signs dashboard session JWTs)
  LOGTO_M2M_APP_ID: ""         # same value as infra-secrets.yaml
  LOGTO_M2M_APP_SECRET: ""     # same value as infra-secrets.yaml
  OVH_APPLICATION_KEY: ""      # dev OVH project API keys
  OVH_APPLICATION_SECRET: ""
  OVH_CONSUMER_KEY: ""

# GitHub App private key (PEM format)
githubPrivateKey: |
  -----BEGIN RSA PRIVATE KEY-----
  ...
  -----END RSA PRIVATE KEY-----

# Registry pull credentials (reader user from the Zot htpasswd)
registryPull:
  password: ""

# Internal JWT keypair for gRPC service-to-service auth (ES256)
# Generate with: make generate-internal-keys
internalJWT:
  privateKey: |
    -----BEGIN EC PRIVATE KEY-----
    ...
    -----END EC PRIVATE KEY-----
  publicKey: |
    -----BEGIN PUBLIC KEY-----
    ...
    -----END PUBLIC KEY-----
